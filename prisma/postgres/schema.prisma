// Prisma schema for MCP Bundler

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth strategy for MCPs in bundles
enum AuthStrategy {
  MASTER   // Use master token from Mcp.masterAuth
  USER_SET // Per-subscription credentials from Subscription.credentials
  NONE     // No authentication required
}

// Bundle - Groups of MCPs with a certain purpose
model Bundle {
  id          String   @id @default(uuid())
  name        String
  description String
  isPublished Boolean  @default(false) @map("is_published")
  path        String?  @unique                              // "publisher/bundle-name" - set on first publish
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")

  // Relations
  createdBy      ApiUser?         @relation("BundleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mcps           MCPBundleEntry[]
  tokens         BundleAccessToken[]
  subscriptions  Subscription[]

  @@unique([name, createdById])
  @@index([createdById])
  @@map("bundles")
}

// MCPs - Master MCP definitions
model Mcp {
  id           String       @id @default(uuid())
  namespace    String       @unique
  url          String
  description  String
  version      String       @default("1.0.0")
  stateless    Boolean      @default(false)
  authStrategy AuthStrategy @default(NONE) @map("auth_strategy")
  masterAuth   String?      @map("master_auth_config") // Encrypted JSON - shared credentials for MASTER strategy
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  createdById  String?      @map("created_by_id")

  // Relations
  createdBy ApiUser?         @relation("McpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mcps      MCPBundleEntry[]

  @@index([createdById])
  @@map("mcps")
}

// Bundle MCPs - Junction table with per-MCP permissions and auth strategy
model MCPBundleEntry {
  id           String       @id @default(uuid())
  bundleId     String       @map("bundle_id")
  mcpId        String       @map("mcp_id")
  bundle       Bundle       @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  mcp          Mcp          @relation(fields: [mcpId], references: [id], onDelete: Cascade)
  addedAt      DateTime     @default(now()) @map("added_at")

  // Per-MCP permissions (shared by all tokens, stored as JSON strings)
  // Use ["*"] for ALL, [] for NONE, or specific tool/resource/prompt names
  allowedTools     String @default("[\"*\"]") @map("allowed_tools")
  allowedResources String @default("[\"*\"]") @map("allowed_resources")
  allowedPrompts   String @default("[\"*\"]") @map("allowed_prompts")

  @@unique([bundleId, mcpId])
  @@map("mcp_bundle_entry")
}

// Subscription - a named subscription to a bundle, owned by a user.
// Holds per-namespace credentials for USER_SET MCPs as a single encrypted blob.
// Access tokens are generated per subscription; credentials are resolved at
// token validation time from the subscription record.
model Subscription {
  id           String    @id @default(uuid())
  name         String
  bundleId     String    @map("bundle_id")
  bundle       Bundle    @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  credentials  String?   @map("credentials")   // Encrypted JSON: { [namespace]: MCPAuthConfig }
  router       String?   @map("router_config") // JSON-serialized BundleRouterConfig
  createdById  String    @map("created_by_id")
  createdBy    ApiUser   @relation("SubscriptionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tokens       BundleAccessToken[]

  @@unique([name, createdById])
  @@index([createdById])
  @@map("subscriptions")
}

// Bundle access tokens
model BundleAccessToken {
  id             String        @id @default(uuid())
  bundleId       String        @map("bundle_id")
  bundle         Bundle        @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  subscriptionId String?       @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  tokenHash      String        @unique @map("token_hash") // SHA-256 hash
  expiresAt      DateTime?     @map("expires_at")
  revoked        Boolean       @default(false)
  createdAt      DateTime      @default(now()) @map("created_at")
  lastUsedAt     DateTime?     @map("last_used_at")
  createdById    String        @map("created_by_id")
  createdBy      ApiUser       @relation("BundleTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)
  pinVersion     Int?          @map("pin_version")   // null = track latest bundle version
  router         String?       @map("router_config") // JSON-serialized BundleRouterConfig; overrides subscription router

  @@map("bundle_access_tokens")
}

// API keys for management API authentication
model ApiUser {
  id          String      @id @default(uuid())
  name        String
  department  String?     @map("department")
  contact     String      @map("contact")
  keyHash     String      @unique @map("key_hash")
  createdAt   DateTime    @default(now()) @map("created_at")
  lastUsedAt  DateTime?   @map("last_used_at")
  revokedAt   DateTime?   @map("revoked_at")
  isAdmin     Boolean     @map("is_admin")
  updatedAt   DateTime    @updatedAt @map("updated_at") @default(now())

  createdById String?     @map("created_by_id")
  createdBy   ApiUser?    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdUsers       ApiUser[]            @relation("CreatedBy")
  permissions        PermissionType[]
  createdBundles     Bundle[]             @relation("BundleCreator")
  createdMcps        Mcp[]                @relation("McpCreator")
  createdTokens      BundleAccessToken[]  @relation("BundleTokenCreator")
  subscriptions      Subscription[]       @relation("SubscriptionCreator")
  llmCredentials     UserLlmCredential[]

  @@index([isAdmin])
  @@index([revokedAt])
  @@index([createdById])
  @@index([lastUsedAt])
  @@map("api_user")
}

// LLM providers pre-seeded in the registry (claude, chatgpt, gemini, etc.)
// Users bind their API key to a provider via UserLlmCredential.
model LlmProvider {
  id          String   @id @default(uuid())
  name        String   @unique                 // e.g. "claude", "chatgpt", "gemini"
  type        String   @default("openai-compatible")
  model       String                           // e.g. "claude-3-5-haiku-20241022"
  endpoint    String                           // OpenAI-compatible base URL
  description String?
  temperature Float    @default(0.1)
  maxTokens   Int      @default(256) @map("max_tokens")
  timeoutMs   Int      @default(10000) @map("timeout_ms")
  createdAt   DateTime @default(now()) @map("created_at")

  credentials UserLlmCredential[]

  @@map("llm_providers")
}

// Per-user encrypted API key binding for a registry LLM provider.
// One record per (user, provider) pair — sync upserts on each run.
model UserLlmCredential {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  providerId String      @map("provider_id")
  user       ApiUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  apiKey     String      @map("api_key")       // AES-256-GCM encrypted
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@unique([userId, providerId])
  @@index([userId])
  @@map("user_llm_credentials")
}

enum PermissionType {
  CREATE_USER
  ADD_MCP
  LIST_USERS
  VIEW_PERMISSIONS
}

// Global settings for self-service registration and other system-wide configs
model GlobalSettings {
  id                            String           @id @default("global")
  allowSelfServiceRegistration  Boolean          @default(false) @map("allow_self_service_registration")
  defaultSelfServicePermissions PermissionType[] @default([]) @map("default_self_service_permissions")

  @@map("global_settings")
}
