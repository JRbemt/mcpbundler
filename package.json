{
  "name": "@jrbemt/mcpbundler",
  "version": "0.2.3",
  "description": "MCP Bundler - Aggregate multiple MCP servers into one",
  "license": "MIT",
  "author": "Joaquín van den Bemt",
  "homepage": "https://github.com/jrbemt/mcpbundler",
  "bugs": "https://github.com/jrbemt/mcpbundler/issues",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "mcpbundler": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrbemt/mcpbundler.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --prefix none \"npm run watch\" \"dotenv -e .env.dev -- nodemon --watch dist --exec node dist/src/main.js\"",
    "cli": "npm run build --silent && node dist/src/cli/index.js",
    "start": "npm run build --silent && node dist/src/main.js",
    "build": "shx rm -rf dist && tsc && shx chmod +x dist/**/*.js",
    "watch": "tsc --watch",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eventsource": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "i": "^0.3.7",
    "lru-cache": "^11.3.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^25",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-istanbul": "^4.1.6",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "msw": "^2.14.6",
    "nodemon": "^3.1.14",
    "shx": "^0.4.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
