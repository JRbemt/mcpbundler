PORT=3000
NODE_ENV=development

# CRITICAL: Change this in production! Minimum 32 characters recommended.
# This key encrypts/decrypts credentials (API keys, passwords, tokens, mTLS keys)
# received from the backend's bundle-resolve response. Must match the backend's
# ENCRYPTION_KEY exactly - both services derive the same AES-256-GCM key from it.
ENCRYPTION_KEY=change-this-to-secure-random-key-min-32-chars

# YAML config mode (self-hosted, no backend)
# When set, the bundler resolves tokens from a static YAML file instead of calling
# the backend API. Secrets referenced in the YAML file (${VAR_NAME}) must still be
# set as env vars here. See mcpbundler.example.yaml for the expected file format.
# YAML_CONFIG=./mcpbundler.yaml

# Backend integration mode (SaaS)
# When set, the bundler resolves bundle tokens by calling the FastAPI backend's
# GET /v1/bundler/resolve endpoint. The backend becomes the single source of
# truth for bundle configurations and access tokens.
# Exactly one of BACKEND_URL or YAML_CONFIG must be set.
# BACKEND_URL=http://localhost:8000

# Anonymous-browsing Keycloak client (client_credentials grant) - used by
# the anonymous MCP discovery session to call the backend's public
# discover endpoints. Set these to the SAME Keycloak client credentials
# mcp-market's own MARKETPLACE_ANON_KEYCLOAK_CLIENT_ID/SECRET use, not a
# newly-provisioned client - the backend's get_security_context only
# recognizes that one client id as a legitimate anonymous caller; any other
# client_credentials token falls through to normal user authentication and
# JIT-provisions a real user account from a machine credential. Two
# separate env vars here only because this runs in a different process
# with its own lifecycle, not because the client itself should differ.
# Anonymous discovery also requires BACKEND_URL above to be set - without it,
# the bundler has no discovery backend to call and falls back to rejecting
# unauthenticated /mcp connections, no matter how these four vars are set.
# KEYCLOAK_SERVER_URL=
# KEYCLOAK_REALM=
# BUNDLER_ANON_KEYCLOAK_CLIENT_ID=
# BUNDLER_ANON_KEYCLOAK_CLIENT_SECRET=

# Public base URL this bundler is reachable at (no trailing slash) - used to
# build the per-bundle OAuth resource URIs and their RFC 9728 Protected
# Resource Metadata document URLs for the native OAuth discovery flow.
# Required (see BUNDLER_NATIVE_OAUTH_ENABLED below) - left unset, resource
# and metadata URLs are relative, which is spec-invalid per RFC 9728/6750.
# Example: https://connect.mcpbundler.ai
# BUNDLER_PUBLIC_URL=

# Device-flow Keycloak client (RFC 8628 Device Authorization Grant) - used by
# bundler__start_connection / bundler__check_connection_status to
# authenticate a human in-session, without the connecting MCP client needing
# any OAuth support itself. Distinct client from BUNDLER_ANON_KEYCLOAK_CLIENT_ID
# above: that one authenticates the bundler itself (client_credentials) for
# read-only catalog calls; this one authenticates a human (device_code) who
# is approving a specific bundle connection. Requires "OAuth 2.0 Device
# Authorization Grant" enabled on this client in Keycloak - configuration
# only, no code changes needed on the Keycloak side.
# BUNDLER_DEVICEFLOW_KEYCLOAK_CLIENT_ID=
# BUNDLER_DEVICEFLOW_KEYCLOAK_CLIENT_SECRET=

# Feature flag gating bundler__start_connection / bundler__check_connection_status.
# Leave unset (or any value other than "true") in production until Phase 5
# (the unified, bundle-aware consent page) lands - until then,
# verification_uri points at Keycloak's own generic device-approval page,
# which is a device-code phishing exposure: a human approving a code there
# has no way to know which agent or bundle they are authorizing. Set to
# "true" only in environments where that risk is accepted (e.g. local
# development against a test Keycloak realm).
# BUNDLER_DEVICE_FLOW_ENABLED=

# Feature flag gating the bundle-scoped /mcp/:bundleId routes (POST/GET/
# DELETE) and the RFC 9728 Protected Resource Metadata document
# (/.well-known/oauth-protected-resource/mcp/:bundleId). Leave unset (or
# any value other than "true") until the backend's POST
# /v1/deployments/bootstrap validates a bootstrap JWT's `aud`/`resource`
# claim against the specific bundle being requested - without that check,
# any valid Keycloak user token could bootstrap a deployment for an
# arbitrary bundle_id. Set to "true" only once that backend deploy has
# landed, and only with BUNDLER_PUBLIC_URL also configured above.
# BUNDLER_NATIVE_OAUTH_ENABLED=

# Feature flag gating the token spend-check middleware (installed on every
# real bundle session when enabled). Leave unset (or any value other than
# "true") until a real path exists for a user's balance to become positive
# on this deployment - grant_subscription_tokens exists on the backend but
# nothing calls it automatically on subscription creation yet, and the
# Stripe/x402 top-up rails both need operator-side payment configuration.
# Enabling this before a grant path exists means every tool call on every
# bundle fails with "Insufficient token balance" for every account. Also
# requires BACKEND_URL above to be set - self-hosted/YAML-config
# deployments have no ledger to check regardless of this flag.
# BUNDLER_TOKEN_BILLING_ENABLED=
