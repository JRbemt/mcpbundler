# For local development with SQLite:
# Use absolute path or path relative to where you run commands from
DATABASE_URL="postgresql://mcpbundler:changethis@localhost:5432/mcp-db"

# For production with PostgreSQL (Docker):
DATABASE_URL="postgresql://mcpbundler:changethis@localhost:5432/mcp-db"
PORT=3000
NODE_ENV=development

# CRITICAL: Change this in production! Minimum 32 characters recommended.
# This key encrypts all credentials (API keys, passwords, tokens, mTLS keys)
# Use a cryptographically secure random string
ENCRYPTION_KEY=change-this-to-secure-random-key-min-32-chars

# Wildcard token configuration (disabled by default for security)
# When enabled, a single token can access ALL MCPs
# Only enable if you understand the security implications
RESOLVER_WILDCARD_ALLOW=true
RESOLVER_WILDCARD_TOKEN=*

# Root administrator configuration
# Used when creating the initial admin user on first startup
ROOT_USER_NAME=Root Administrator
ROOT_USER_EMAIL=admin@example.com

# Self-service user registration settings
# When enabled, users can create their own API keys via POST /api/users/self-service
# SECURITY WARNING: Only enable if you understand the implications
SELF_SERVICE_ENABLED=false

# Default permissions granted to self-service registered users
# Valid values: CREATE_USER, ADD_MCP, LIST_USERS (comma-separated)
# Leave empty for no permissions (users must be granted permissions by admin)
SELF_SERVICE_DEFAULT_PERMISSIONS=CREATE_USER,ADD_MCP

# YAML config mode (optional)
# When set, the bundler resolves tokens from a static YAML file instead of the database.
# No DATABASE_URL or ENCRYPTION_KEY is required in this mode.
# Secrets referenced in the YAML file (${VAR_NAME}) must still be set as env vars here.
# See mcpbundler.example.yaml for the expected file format.
# YAML_CONFIG=./mcpbundler.yaml

# Example bundle tokens (only needed when YAML_CONFIG is active)
# DEV_BUNDLE_TOKEN=your-dev-secret-token
# READONLY_BUNDLE_TOKEN=your-readonly-token

# Backend integration (optional)
# When set, the bundler resolves bundle tokens by calling the FastAPI backend
# instead of querying its local database.  The backend becomes the single source
# of truth for bundle configurations and access tokens.
# Both services must share the same ENCRYPTION_KEY value.
# Leave unset to run the bundler in standalone mode (DBBundleResolver).
# BACKEND_URL=http://localhost:8000

# (Used by docker-compose.yml)
POSTGRES_USER=mcpbundler
POSTGRES_PASSWORD=changethis
POSTGRES_DB=mcp-db